# Copy to .env.local (Next.js) and/or set in Vercel Project Settings -> Environment Variables.
# Never commit an actual .env file. See docs/SECURITY.md.

# --- Supabase ---
# Public: safe to ship to the browser. This project doesn't actually call Supabase client-side
# (docs/ARCHITECTURE.md decision #2), so treat even these as server-preferred where possible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server-side only (n8n credentials, Next.js server routes). NEVER in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:migrate` to apply
# supabase/migrations/. Supabase dashboard -> Project Settings -> Database -> Connection string
# (URI). Server-side only.
SUPABASE_DB_URL=

# --- Seed script (npm run seed) ---
SEED_CLINIC_NAME=V-Unite Aesthetic Clinic

# --- n8n ---
N8N_CHAT_WEBHOOK_URL=
N8N_VOICE_WEBHOOK_URL=
N8N_KNOWLEDGE_WEBHOOK_URL=
# Shared secret Next.js sends as `Authorization: Bearer <this>`; n8n validates it. docs/SECURITY.md
N8N_WEBHOOK_SECRET=

# --- Fish Audio (docs/VOICE.md) ---
# Base URL https://api.fish.audio/, sent as `Authorization: Bearer <this>`. Server-side only.
FISH_AUDIO_API_KEY=

# --- LLM (docs/AI_AGENT.md) ---
# Keep these swappable — never hardcode a model string in app or n8n workflow code.
# Chat/reasoning runs inside n8n (Groq credential there); these are for local scripts/tests.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- Embeddings (docs/AI_AGENT.md, docs/DATABASE.md) ---
# Cohere embed-english-v3.0 -> 1024 dims (migration 0004). Changing the model means a new
# migration to resize knowledge_chunks.embedding + match_knowledge_chunks BEFORE re-ingesting.
# Embedding calls run inside n8n WF-03 (Cohere credential there); this key is only for local
# ingestion/test scripts, if any.
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-english-v3.0
EMBEDDING_API_KEY=
