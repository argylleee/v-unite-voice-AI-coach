# Copy the "Required by the deployed app" block into .env.local for local dev, and into
# Vercel -> Project Settings -> Environment Variables for production. Never commit a real .env.
# See docs/SECURITY.md.


# ============================================================================
# Required by the deployed app
# ============================================================================

# --- Supabase ---
# Server URL. The app only reads Supabase from server-side routes (docs/ARCHITECTURE.md #2).
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key — server-side only, NEVER in browser code. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n webhooks ---
# The app POSTs to these; n8n does all AI orchestration (agent, tools, RAG, STT/TTS).
N8N_CHAT_WEBHOOK_URL=
N8N_VOICE_WEBHOOK_URL=
N8N_KNOWLEDGE_WEBHOOK_URL=
N8N_SUMMARY_WEBHOOK_URL=
# Shared secret sent as `Authorization: Bearer <this>`; every workflow validates it first.
N8N_WEBHOOK_SECRET=

# --- Frontend (single demo clinic, no auth) ---
# Both have a code default; set them only to override.
NEXT_PUBLIC_CLINIC_ID=80a1c835-ed66-4c0c-8c3c-52c5e90fdbf4
NEXT_PUBLIC_CLINIC_NAME=V-Unite Aesthetic Clinic


# ============================================================================
# Local tooling only — NOT needed on Vercel
# ============================================================================

# Direct Postgres URI, used only by `npm run db:migrate` to apply supabase/migrations/.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI). Use the
# session pooler host (port 5432, aws-0-*.pooler.supabase.com) — the direct host is IPv6-only.
SUPABASE_DB_URL=
# Clinic name the seed script writes (`npm run seed`). Has a code default.
SEED_CLINIC_NAME=V-Unite Aesthetic Clinic


# ============================================================================
# Configured inside n8n — listed for reference only, NOT read by this codebase
# ============================================================================
# The model, embeddings, and voice STT/TTS all run inside n8n workflows using credentials in
# the n8n credential store on the Railway instance. Nothing in this repo reads the values
# below; they record what those credentials are set to.
#
#   LLM            DeepSeek (OpenAI-compatible). Base URL https://api.deepseek.com,
#                  model deepseek-chat. n8n credential: "DeepSeek". Used by WF-01, WF-04.
#
#   Embeddings     Cohere embed-english-v3.0 -> 1024 dims (migration 0004).
#                  n8n credential: "Cohere". Used by WF-03 and the knowledge_search sub-workflow.
#                  Changing the model requires a new migration to resize
#                  knowledge_chunks.embedding + match_knowledge_chunks BEFORE re-ingesting.
#
#   Voice output   Fish Audio TTS. Free model s2.1-pro-free,
#                  reference_id 9a9cf47702da476aa4629e2506d4a857.
#                  n8n credential: "Fish Audio". Used by WF-02.
#
#   Voice input    Groq Whisper, model whisper-large-v3-turbo.
#                  n8n credential: "Groq account". Used by WF-02.
#                  Fish's /v1/asr has no free tier (402) -> STT uses Groq instead. This is a
#                  deviation from PROJECT_SPEC, flagged to Emman; swap WF-02's STT node back
#                  to Fish if API credit is provided.
