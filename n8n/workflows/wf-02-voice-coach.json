    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (!buf || buf.length < 100) { throw new Error('tts_no_audio'); }\nconst meta = ($input.first().binary || {}).data || {};\nreturn [{ json: {\n  transcript: $('Parse Answer').first().json.transcript,\n  answer: $('Parse Answer').first().json.answer,\n  audio_base64: buf.toString('base64'),\n  audio_mime: meta.mimeType || 'audio/mpeg'\n} }];"
