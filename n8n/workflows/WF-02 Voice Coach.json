    {
      "parameters": {
        "jsCode": "let raw=($json.agent_output||$json.output||'').toString().trim();\nraw=raw.replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'').trim();\nlet obj=null;try{obj=JSON.parse(raw);}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(m){try{obj=JSON.parse(m[0]);}catch(_){}}}\nlet answer=(obj&&typeof obj.answer==='string'&&obj.answer.trim())?obj.answer:raw;\nif(!answer)answer='Sorry, I could not produce an answer for that.';\nreturn [{json:{transcript:$('Build Coach Request').first().json.transcript,answer:answer}}];"
      },
