        "options": {
          "queryReplacement": "={{ $('Normalize Request').first().json.clinicId }}, {{ $('Normalize Request').first().json.filename }}, {{ $('Normalize Request').first().json.fileType }}, {{ $('Normalize Request').first().json.visitorHash }}"
