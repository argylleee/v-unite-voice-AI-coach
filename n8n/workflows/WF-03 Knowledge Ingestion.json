    {
      "parameters": {
        "jsCode": "const s=$input.first().json;const raw=(s.text||s.data||s.content||'').toString();const clean=raw.replace(/\\r\\n/g,'\\n').replace(/\\n{3,}/g,'\\n\\n').trim();if(!clean){throw new Error('no_text_extracted');}if(clean.length>40000){throw new Error('extracted_text_too_large');}const SIZE=2000,OVERLAP=300,out=[];let i=0;while(i<clean.length){const p=clean.slice(i,i+SIZE).trim();if(p)out.push(p);i+=SIZE-OVERLAP;}return out.map((content,idx)=>({json:{content,chunk_index:idx}}));"
      },
