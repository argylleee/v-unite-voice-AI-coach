    {
      "parameters": {
        "jsCode": "const v=$json.embeddings&&$json.embeddings.float;const c=$('Split Into Chunks').all().map(i=>i.json);if(!Array.isArray(v)||v.length!==c.length){throw new Error('embedding_count_mismatch');}const docId=$('Insert Document Row').first().json.id;const clinicId=$('Normalize Request').first().json.clinicId;const filename=$('Normalize Request').first().json.filename;const visitorHash=$('Normalize Request').first().json.visitorHash;return c.map((x,idx)=>({json:{document_id:docId,clinic_id:clinicId,visitor_token_hash:visitorHash,content:x.content,chunk_index:x.chunk_index,embedding:'['+v[idx].join(',')+']',metadata:JSON.stringify({source:filename,chunk_index:x.chunk_index})}}));"
      },
