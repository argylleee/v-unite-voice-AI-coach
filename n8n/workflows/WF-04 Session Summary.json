    {
      "parameters": {
        "jsCode": "let raw=($json.output||$json.text||$json.agent_output||'').toString().trim();\nraw=raw.replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'').trim();\nlet obj=null;try{obj=JSON.parse(raw);}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(m){try{obj=JSON.parse(m[0]);}catch(_){}}}\nif(!obj||typeof obj!=='object')obj={};\nconst summary=(typeof obj.summary==='string'&&obj.summary.trim())?obj.summary:(raw||'Session summary unavailable.');\nconst kf=Array.isArray(obj.key_findings)?obj.key_findings.filter(x=>typeof x==='string'):[];\nlet ap=Array.isArray(obj.action_plan)?obj.action_plan:[];\nap=ap.map(x=>({action:String((x&&x.action)||x||'').trim(),priority:['high','medium','low'].includes(x&&x.priority)?x.priority:'medium'})).filter(x=>x.action);\nreturn [{json:{summary:summary,key_findings:kf,action_plan:ap}}];"
      },
