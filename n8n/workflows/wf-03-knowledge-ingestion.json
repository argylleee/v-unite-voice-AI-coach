    {
      "parameters": {
        "jsCode": "const s=$input.first().json;const raw=(s.text||s.data||s.content||'').toString();const clean=raw.replace(/\\r\\n/g,'\\n').replace(/\\n{3,}/g,'\\n\\n').trim();if(!clean){throw new Error('no_text_extracted');}const SIZE=2000,OVERLAP=300,out=[];let i=0;while(i<clean.length){const p=clean.slice(i,i+SIZE).trim();if(p)out.push(p);i+=SIZE-OVERLAP;}return out.map((content,idx)=>({json:{content,chunk_index:idx}}));"
      },
      "id": "667492dc-f1a2-4fcc-9f67-897c1ac344d2",
      "name": "Chunk",
