    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cohere.com/v2/embed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"embed-english-v3.0\", \"input_type\": \"search_document\", \"embedding_types\": [\"float\"], \"texts\": $('Chunk').all().map(i => i.json.content) } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "6bb762a0-ea4e-4a5e-ba34-367006455781",
      "name": "Cohere Embed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -672,
        128
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Cohere Header"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const v=$json.embeddings&&$json.embeddings.float;const c=$('Chunk').all().map(i=>i.json);if(!Array.isArray(v)||v.length!==c.length){throw new Error('embedding_count_mismatch');}const docId=$('Insert Document').first().json.id;const clinicId=$('Normalize').first().json.clinicId;const filename=$('Normalize').first().json.filename;return c.map((x,idx)=>({json:{document_id:docId,clinic_id:clinicId,content:x.content,chunk_index:x.chunk_index,embedding:'['+v[idx].join(',')+']',metadata:JSON.stringify({source:filename,chunk_index:x.chunk_index})}}));"
      },
